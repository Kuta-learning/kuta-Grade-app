# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and loaded at app startup by flutter_dotenv.

# Backend API base URL (including the `/api` prefix).
API_BASE_URL=https://your-backend-host.example.com/api

# Google OAuth Web Client ID issued by the backend team's Google Cloud project.
# This must be the WEB client (passed as serverClientId). The ANDROID OAuth
# client is never placed in the app - Google matches it server-side against
# the applicationId + signing SHA-1.
GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
